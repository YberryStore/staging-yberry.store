rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isSuperAdmin() {
      return request.auth != null && (
        request.auth.token.admin == true ||
        request.auth.token.role == 'super_admin' ||
        request.auth.token.email in [
          'info@yberry.co.za',
          'admin@yellowberry.store',
          'admin@ystoreza.co.za',
          'support@yellowberry.store'
        ]
      );
    }

    // User profile avatars & user-uploaded content
    match /users/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Storefront images & content (products, categories, specials, blog, banners, media, story-thumbnails, story-slides, etc.)
    match /{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null || isSuperAdmin();
    }
  }
}
